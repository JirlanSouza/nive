use nive::prelude::ui::*;

mod icons;

struct {{app_name_title}}App {
    projects: Resource<Vec<String>>,
    dialog_open: bool,
}

#[derive(Debug, Clone)]
enum Message {
    RefreshProjects,
    ProjectsSettled(Settled<Vec<String>>),
    OpenDialog,
    DismissDialog,
}

impl Application for {{app_name_title}}App {
    type Message = Message;
    type Window = ();
    type Bootstrap = ();

    fn config() -> ApplicationConfig<Self::Window, Self::Bootstrap> {
        ApplicationConfig::new("{{app_name}}").theme_catalog(app_theme_catalog())
    }

    fn init(_context: Context<'_, Self::Window>, _bootstrap: Self::Bootstrap) -> (Self, impl Into<Effect<Self::Message, Self::Window>>) {
        (
            Self {
                projects: Resource::idle(),
                dialog_open: false,
            },
            Effect::toast(Toast::info("Welcome to the {{app_name_title}} dashboard")),
        )
    }

    fn update(&mut self, _context: Context<'_, Self::Window>, _message_context: MessageContext<Self::Window>, message: Self::Message) -> impl Into<Effect<Self::Message, Self::Window>> {
        match message {
            Message::RefreshProjects => {
                let task = self.projects.load(fetch_projects(), Message::ProjectsSettled);
                Effect::task(task)
            }
            Message::ProjectsSettled(settled) => {
                let succeeded = settled.result().is_ok();
                self.projects.settle(settled);
                if succeeded {
                    Effect::toast(Toast::success("Projects refreshed"))
                } else {
                    Effect::none()
                }
            }
            Message::OpenDialog => {
                self.dialog_open = true;
                Effect::none()
            }
            Message::DismissDialog => {
                self.dialog_open = false;
                Effect::none()
            }
        }
    }

    fn view(&self, _context: Context<'_, Self::Window>, _window: WindowContext<Self::Window>) -> ScreenView<'_, Self::Message> {
        let body: nive::Element<'_, Message> = if self.projects.is_loading() && self.projects.value().is_none() {
            nive::prelude::column![text("Loading...")].into()
        } else if let Some(error) = self.projects.error() {
            nive::prelude::column![text(error.summary())].into()
        } else if let Some(projects) = self.projects.value() {
            if projects.is_empty() {
                nive::prelude::column![text("No projects yet.")].into()
            } else {
                nive::prelude::column(projects.iter().map(|p| text(p.as_str())).map(nive::Element::from)).into()
            }
        } else {
            nive::prelude::column![text("Press Refresh to load projects.")].into()
        };

        let refresh_button = button("Refresh").on_press(Message::RefreshProjects);
        let open_dialog_button = button("Open dialog").on_press(Message::OpenDialog);

        ScreenView::new(
            nive::prelude::column![body, nive::prelude::row![refresh_button, open_dialog_button].spacing(10)]
                .padding(20)
                .spacing(10),
        )
        .dialog_maybe(self.dialog_open.then(|| {
            let dialog = Dialog::new(text("Are you sure you want to continue?"))
                .size(DialogSize::Sm)
                .header(DialogHeader::new("Confirm action"))
                .footer(DialogActionFooter::with_one(
                    DialogAction::cancel("Cancel", Message::DismissDialog),
                    DialogTerminalAction::primary("Continue", Message::DismissDialog),
                ));

            DialogRequest::new(dialog).dismiss_on_backdrop_or_escape(Message::DismissDialog)
        }))
    }
}

fn app_theme_catalog() -> ThemeCatalog {
    ThemeCatalog::new(
        Theme::builder("{{app_name_title}} Light", ThemeMode::Light)
            .icons(icons::APP_ICON_CATALOG)
            .build(),
        Theme::builder("{{app_name_title}} Dark", ThemeMode::Dark)
            .icons(icons::APP_ICON_CATALOG)
            .build(),
    )
}

async fn fetch_projects() -> UserFacingResult<Vec<String>> {
    // Stand-in for a real async datasource.
    Ok(vec![
        "Project Alpha".to_string(),
        "Project Beta".to_string(),
        "Project Gamma".to_string(),
    ])
}

fn main() -> nive::Result {
    nive::run::<{{app_name_title}}App>()
}
