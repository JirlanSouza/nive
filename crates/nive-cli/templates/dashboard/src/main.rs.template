use nive::prelude::ui::*;

struct {{app_name_title}}App {
    projects: Resource<Vec<String>>,
    pending_dialog: Option<DialogRequest<Message>>,
}

#[derive(Debug, Clone)]
enum Message {
    RefreshProjects,
    ProjectsSettled(Settled<Vec<String>>),
    OpenDialog,
    DismissDialog,
}

impl Application for {{app_name_title}}App {
    type Message = Message;
    type Window = ();
    type Bootstrap = ();

    fn config() -> ApplicationConfig<Self::Window, Self::Bootstrap> {
        ApplicationConfig::new("{{app_name}}")
    }

    fn init(_context: Context<'_, Self::Window>, _bootstrap: Self::Bootstrap) -> (Self, impl Into<AppUpdate<Self::Message, Self::Window>>) {
        (
            Self {
                projects: Resource::idle(),
                pending_dialog: None,
            },
            AppUpdate::none().toast(Toast::info("Welcome to the {{app_name_title}} dashboard")),
        )
    }

    fn update(&mut self, _context: Context<'_, Self::Window>, _window: Option<WindowContext<Self::Window>>, message: Self::Message) -> impl Into<AppUpdate<Self::Message, Self::Window>> {
        match message {
            Message::RefreshProjects => {
                let task = self.projects.load(fetch_projects(), Message::ProjectsSettled);
                AppUpdate::from_task(task)
            }
            Message::ProjectsSettled(settled) => {
                let succeeded = settled.result().is_ok();
                self.projects.settle(settled);
                if succeeded {
                    AppUpdate::none().toast(Toast::success("Projects refreshed"))
                } else {
                    AppUpdate::none()
                }
            }
            Message::OpenDialog => {
                self.pending_dialog = Some(
                    DialogRequest::new(column![text("Are you sure you want to continue?")])
                        .dismiss_on_backdrop_or_escape(Message::DismissDialog),
                );
                AppUpdate::none()
            }
            Message::DismissDialog => {
                self.pending_dialog = None;
            }
        }
    }

    fn view(&self, _context: Context<'_, Self::Window>, _window: WindowContext<Self::Window>) -> ScreenView<'_, Self::Message> {
        let body: nive::Element<'_, Message> = if self.projects.is_loading() && self.projects.value().is_none() {
            column![text("Loading...")].into()
        } else if let Some(error) = self.projects.error() {
            column![text(error.summary())].into()
        } else if let Some(projects) = self.projects.value() {
            if projects.is_empty() {
                column![text("No projects yet.")].into()
            } else {
                column(projects.iter().map(|p| text(p.as_str())).map(nive::Element::from)).into()
            }
        } else {
            column![text("Press Refresh to load projects.")].into()
        };

        let refresh_button = button("Refresh").on_press(Message::RefreshProjects);
        let open_dialog_button = button("Open dialog").on_press(Message::OpenDialog);

        ScreenView::new(
            column![body, row![refresh_button, open_dialog_button].spacing(10)]
                .padding(20)
                .spacing(10),
        )
        .dialog_maybe(self.pending_dialog.clone())
    }
}

async fn fetch_projects() -> Result<Vec<String>, UserFacingError> {
    // Stand-in for a real async datasource.
    Ok(vec![
        "Project Alpha".to_string(),
        "Project Beta".to_string(),
        "Project Gamma".to_string(),
    ])
}

fn main() -> nive::Result {
    nive::run::<{{app_name_title}}App>()
}
