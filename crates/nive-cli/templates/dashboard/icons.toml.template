[provider.lucide]
version = "0.460.0"
stroke_width = "2"
stroke_linecap = "round"
stroke_linejoin = "round"

[roles]
action-confirm = "lucide:check"
dialog-error = "lucide:circle-alert"
dialog-information = "lucide:info"
dialog-success = "lucide:circle-check"
dialog-warning = "lucide:triangle-alert"
edit-copy = "lucide:copy"
edit-delete = "lucide:trash"
edit-find = "lucide:search"
edit-modify = "lucide:pencil"
folder = "lucide:folder"
go-next = "lucide:arrow-right"
go-previous = "lucide:arrow-left"
list-add = "lucide:plus"
list-remove = "lucide:minus"
mail-inbox = "lucide:inbox"
nive-disclosure-down = "lucide:chevron-down"
nive-disclosure-left = "lucide:chevron-left"
nive-disclosure-right = "lucide:chevron-right"
nive-disclosure-up = "lucide:chevron-up"
open-menu = "lucide:menu"
preferences-system = "lucide:settings"
view-conceal = "lucide:eye-off"
view-more = "lucide:ellipsis"
view-refresh = "lucide:refresh-cw"
view-reveal = "lucide:eye"
window-close = "lucide:x"

[symbols]

