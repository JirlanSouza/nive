[provider.lucide]
version = "0.460.0"
stroke_width = "2"
stroke_linecap = "round"
stroke_linejoin = "round"

# Semantic roles the framework's widgets render. Nive ships a default glyph for
# every one of them, so this section stays empty until you want to replace one:
#
#   window-close = "lucide:x"
#   folder = "custom:brand-folder"
#
# `nive icons list` shows the roles and their current glyphs; `nive icons search
# <query>` and `nive icons gallery --open` help pick a replacement.
[roles]

# Icons this app renders directly, generated as named Rust variants:
#
#   BrandMark = "custom:brand-mark"
#
# Add one with `nive icons add-symbol BrandMark custom:brand-mark`.
[symbols]

# Local SVG files referenced as `custom:<name>`:
#
#   brand-mark = "assets/icons/brand-mark.svg"
#
# Add one with `nive icons add-custom brand-mark assets/icons/brand-mark.svg`.
[custom]
