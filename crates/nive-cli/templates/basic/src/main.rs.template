use nive::prelude::*;

mod icons;

struct {{app_name_title}}App {
    counter: i32,
}

#[derive(Debug, Clone, Copy)]
enum Message {
    Increment,
    Decrement,
}

impl Application for {{app_name_title}}App {
    type Message = Message;
    // `Window = ()` and `Bootstrap = ()` opt into the SimpleApplication
    // marker: the runtime auto-registers one default window (no `Window`
    // enum, no splash flow needed).
    type Window = ();
    type Bootstrap = ();

    fn config() -> ApplicationConfig<Self::Window, Self::Bootstrap> {
        ApplicationConfig::new("{{app_name}}").theme_catalog(app_theme_catalog())
    }

    fn init(_context: Context<'_, Self::Window>, _bootstrap: Self::Bootstrap) -> (Self, impl Into<Effect<Self::Message, Self::Window>>) {
        (Self { counter: 0 }, ())
    }

    fn update(&mut self, _context: Context<'_, Self::Window>, _message_context: MessageContext<Self::Window>, message: Self::Message) -> impl Into<Effect<Self::Message, Self::Window>> {
        match message {
            Message::Increment => self.counter += 1,
            Message::Decrement => self.counter -= 1,
        }
    }

    fn view(&self, _context: Context<'_, Self::Window>, _window: WindowContext<Self::Window>) -> ScreenView<'_, Self::Message> {
        ScreenView::new(nive::prelude::column![button("+").on_press(Message::Increment), text(self.counter), button("-").on_press(Message::Decrement)].padding(20).spacing(10))
    }
}

fn app_theme_catalog() -> ThemeCatalog {
    ThemeCatalog::new(
        Theme::builder("{{app_name_title}} Light", ThemeMode::Light)
            .icons(icons::APP_ICON_CATALOG)
            .build(),
        Theme::builder("{{app_name_title}} Dark", ThemeMode::Dark)
            .icons(icons::APP_ICON_CATALOG)
            .build(),
    )
}

fn main() -> nive::Result {
    nive::run::<{{app_name_title}}App>()
}
