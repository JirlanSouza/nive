# {{app_name}} - Development Commands

# Build the app
build:
    cargo build

# Run in development mode
dev:
    cargo run

# Check the app
check:
    cargo check --all-targets

# Test the app
test:
    cargo test

# Initialize icons manifest
icons-init:
    nive icons init

# Sync icons
icons-sync:
    nive icons sync

# Check icons
icons-check:
    nive icons check

# Add app symbol. Usage: just icons-add-symbol User user
icons-add-symbol variant provider_ref:
    nive icons add-symbol {{ variant }} {{ provider_ref }}

# Set framework role. Usage: just icons-set-role window-close lucide:x
icons-set-role role provider_ref:
    nive icons set-role {{ role }} {{ provider_ref }}
