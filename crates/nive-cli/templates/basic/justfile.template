# {{app_name}} - Development Commands

# Build the app
build:
    cargo build

# Run in development mode
dev:
    cargo run

# Check the app
check:
    cargo check --all-targets

# Test the app
test:
    cargo test

# Initialize icons manifest
icons-init:
    nive icons init

# Sync icons
icons-sync:
    nive icons sync

# Check icons
icons-check:
    nive icons check

# Add icon. Usage: just icons-add Search search
icons-add variant lucide_name:
    nive icons add {{ variant }} {{ lucide_name }}
